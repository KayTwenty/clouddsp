// cloudDSP job queue. Run `npx prisma generate` after changing this file and
// `npx prisma migrate dev` to create a migration.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One track going through the GPU pipeline. Files live in R2 (or local disk in
// dev); this row tracks where they are and how far along the job is.
model Job {
  id         String    @id @default(uuid()) @db.Uuid
  filename   String
  size       Int
  deviceId   String
  output     String // "mod" | "tracks"
  modFormat  String? // "cdj3k"
  preset     String // "fast" | "balanced" | "quality"
  format     String // "wav" | "flac" | "mp3"
  status     String    @default("awaiting_upload") // awaiting_upload | queued | processing | done | failed
  stage      String?
  percent    Int?
  error      String?
  notes      String[]
  inputKey   String
  outputs    Json      @default("[]") // JobOutput[]
  preview    Json? // JobPreview
  live       Json? // JobLive, only while processing
  leaseUntil DateTime?
  workerId   String? // worker that last claimed it
  startedAt  DateTime? // claimed by a worker
  finishedAt DateTime? // done or failed
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Workers look up the oldest claimable job.
  @@index([status, createdAt])
  // The status page counts the last 24 hours of finished jobs.
  @@index([finishedAt])
}

// A GPU worker, as last seen. Updated on every poll and progress report, which
// is what the public status page reads.
model Worker {
  id        String   @id // stable per machine and GPU, chosen by the worker
  name      String
  gpu       Json? // GpuSample
  status    String   @default("idle") // idle | busy
  jobId     String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
}
