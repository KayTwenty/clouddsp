# Copy to .env (or .env.local) and fill in what you need. Every group is
# optional: leave it empty and cloudDSP uses its built-in local fallback.
# On Vercel, set these in Project Settings > Environment Variables.

# --- GPU workers ------------------------------------------------------------------
# Shared secret the workers send as "Authorization: Bearer <token>".
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. `npm run selfhost` creates one for you if unset.
WORKER_TOKEN=

# Optional: how the worker appears on the /status page (defaults to the GPU model).
WORKER_NAME=

# Optional: force the worker's PyTorch build, cu126 (GTX 10-series) or cu128.
# Normally worker/start.py picks it from nvidia-smi.
CLOUDDSP_TORCH=

# --- Database (optional) -------------------------------------------------------------
# PostgreSQL connection string, e.g. Prisma Postgres from the Vercel Marketplace.
# Use a direct postgres:// URL, not prisma+postgres://.
# Without it, jobs are stored as JSON files in .data/jobs.
DATABASE_URL=

# --- File storage (optional) -------------------------------------------------------
# Any S3-compatible object storage: Cloudflare R2, MinIO, AWS S3, Backblaze B2...
# Without it, files are stored in .data/storage and served by the site itself.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Cloudflare R2 shorthand, instead of the S3_* values above.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Set to "local" to use built-in storage even when keys above are present.
STORAGE=

# Hours to keep uploads and results in built-in storage (default 48, 0 = forever).
# With object storage, use a lifecycle rule on the bucket instead.
RETENTION_HOURS=

# --- Site (optional) ------------------------------------------------------------------
# Public URL, used for canonical links, the sitemap and social cards.
# Vercel sets the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Link to this instance's source code (footer). If you run a modified copy as
# a public site, the AGPL asks you to point this at your changes.
NEXT_PUBLIC_SOURCE_URL=
